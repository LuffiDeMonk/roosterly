{
  "name": "roosterly",
  "version": "1.0.0",
  "private": true,
  "description": "Roosterly full-stack monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev --workspace=@roosterly/backend\" \"npm run dev --workspace=@roosterly/frontend\"",
    "dev:backend": "npm run dev --workspace=@roosterly/backend",
    "dev:frontend": "npm run dev --workspace=@roosterly/frontend",
    "build": "npm run build --workspace=@roosterly/backend && npm run build --workspace=@roosterly/frontend",
    "build:backend": "npm run build --workspace=@roosterly/backend",
    "build:frontend": "npm run build --workspace=@roosterly/frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
